rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Bloqueo global por defecto (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Validación de conexión inicial (solo lectura puntual de documento específico)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // 2. Colecciones estrictamente privadas del backend (solo Firebase Admin SDK)
    match /accounts/{usernameLower} {
      allow read, write: if false;
    }

    match /accountSecrets/{usernameLower} {
      allow read, write: if false;
    }

    match /userSecurity/{uid} {
      allow read, write: if false;
    }

    match /authRateLimits/{bucketKey} {
      allow read, write: if false;
    }

    // 3. Funciones auxiliares de identidad, sesión y época de seguridad
    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_.-]+$');
    }

    function isValidMonthKey(key) {
      return key is string
        && key.size() == 7
        && key.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function hasValidUserSecurityDoc(userId, tokenEpoch, sec) {
      return sec.get('uid', '') == userId
        && ('minSessionEpoch' in sec)
        && sec.minSessionEpoch is int
        && sec.minSessionEpoch >= 1
        && tokenEpoch >= sec.minSessionEpoch;
    }

    function hasValidNitaSecurityEpoch(userId, tok) {
      return userId.size() >= 5
        && ('sessionEpoch' in tok)
        && tok.sessionEpoch is int
        && tok.sessionEpoch >= 1
        && exists(/databases/$(database)/documents/userSecurity/$(userId))
        && hasValidUserSecurityDoc(
          userId,
          tok.sessionEpoch,
          get(/databases/$(database)/documents/userSecurity/$(userId)).data
        );
    }

    function matchesOwnerProviderRules(userId, tok, isUsr, isCustomPwd) {
      return (isUsr && isCustomPwd && hasValidNitaSecurityEpoch(userId, tok))
        || (!isUsr && !isCustomPwd);
    }

    function isValidOwnerToken(userId, tok) {
      return !('firebase' in tok
          && 'sign_in_provider' in tok.firebase
          && tok.firebase.sign_in_provider == 'anonymous')
        && matchesOwnerProviderRules(
          userId,
          tok,
          userId.matches('^usr_.*'),
          tok.get('provider', '') == 'nita_password'
        );
    }

    function isAuthorizedOwner(userId) {
      return request.auth != null
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidOwnerToken(userId, request.auth.token);
    }

    function isValidCurrency(curr) {
      return curr in [
        'ARS', 'BOB', 'BRL', 'BZD', 'CLP', 'COP', 'CRC', 'CUP', 'DOP', 'EUR',
        'GTQ', 'GYD', 'HNL', 'HTG', 'MXN', 'NIO', 'PAB', 'PEN', 'PYG', 'SRD',
        'USD', 'UYU', 'VES'
      ];
    }

    function isCoherentMonthYear(key, y, m) {
      return y is int
        && y >= 1970
        && y <= 2200
        && string(y) == key[0:4]
        && m is int
        && m >= 0
        && m <= 11
        && ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'][m] == key[5:7];
    }

    // 4. Validadores estructurales de listas y documentos financieros
    function isValidCategoryMap(cat) {
      let k = cat.keys();
      let id = cat.id;
      let label = cat.label;
      let color = cat.color;
      return (
          (
            k.size() == 3
            || (
              k.hasOnly(['id', 'label', 'color', 'isCustom', 'badgeBg', 'badgeText'])
              && (!('isCustom' in cat) || cat.isCustom == null || cat.isCustom is bool)
              && (!('badgeBg' in cat) || cat.badgeBg == null || (cat.badgeBg is string && cat.badgeBg.size() <= 64))
              && (!('badgeText' in cat) || cat.badgeText == null || (cat.badgeText is string && cat.badgeText.size() <= 64))
            )
          )
        )
        && id is string && id.size() > 0 && id.size() <= 64
        && label is string && label.size() <= 100
        && color is string && color.size() <= 32;
    }
    function isValidCategoryItem(cat) {
      return cat is map && isValidCategoryMap(cat);
    }

    function isValidFixedExpenseMap(exp) {
      let k = exp.keys();
      return (
          k.size() == 5
          || (
            k.hasOnly(['id', 'name', 'amount', 'category', 'isPaid', 'dueDate', 'notes'])
            && (!('dueDate' in exp) || exp.dueDate == null || (exp.dueDate is number && exp.dueDate >= 0 && exp.dueDate <= 31))
            && (!('notes' in exp) || exp.notes == null || (exp.notes is string && exp.notes.size() <= 500))
          )
        )
        && exp.id is string && exp.id.size() > 0 && exp.id.size() <= 64
        && exp.name is string && exp.name.size() <= 150
        && exp.amount is number && exp.amount >= 0
        && exp.category is string && exp.category.size() <= 64
        && exp.isPaid is bool;
    }

    function isValidFixedExpense(exp) {
      return exp is map && isValidFixedExpenseMap(exp);
    }

    function isValidVariableExpenseMap(exp) {
      let k = exp.keys();
      return (
          k.size() == 4
          || (
            k.hasOnly(['id', 'date', 'description', 'amount', 'category'])
            && (exp.description == null || (exp.description is string && exp.description.size() <= 200))
          )
        )
        && exp.id is string && exp.id.size() > 0 && exp.id.size() <= 64
        && exp.amount is number && exp.amount >= 0
        && exp.category is string && exp.category.size() <= 64
        && exp.date is string
        && exp.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function isValidVariableExpense(exp) {
      return exp is map && isValidVariableExpenseMap(exp);
    }

    function areValidCategoryElements(cats) {
      let n = cats.size();
      return n <= 100
        && (
          n == 0
          || (
            isValidCategoryItem(cats[0])
            && (n <= 1 || (isValidCategoryItem(cats[1])
            && (n <= 2 || (isValidCategoryItem(cats[2])
            && (n <= 3 || (isValidCategoryItem(cats[3])
            && (n <= 4 || (isValidCategoryItem(cats[4])
            && (n <= 5 || (isValidCategoryItem(cats[5])
            && (n <= 6 || (isValidCategoryItem(cats[6])
            && (n <= 7 || (isValidCategoryItem(cats[7])
            && (n <= 8 || (isValidCategoryItem(cats[8])
            && (n <= 9 || (isValidCategoryItem(cats[9])
            && (n <= 10 || isValidCategoryItem(cats[n - 1]))
            )))))))))))))))))))
        );
    }

    function areValidCategories(cats) {
      return cats is list && areValidCategoryElements(cats);
    }

    function areValidFixedExpenseElements(list) {
      let n = list.size();
      return n <= 300
        && (
          n == 0
          || (
            isValidFixedExpense(list[0])
            && (n <= 1 || (isValidFixedExpense(list[1])
            && (n <= 2 || (isValidFixedExpense(list[2])
            && (n <= 3 || (isValidFixedExpense(list[3])
            && (n <= 4 || (isValidFixedExpense(list[4])
            && (n <= 5 || (isValidFixedExpense(list[5])
            && (n <= 6 || (isValidFixedExpense(list[6])
            && (n <= 7 || (isValidFixedExpense(list[7])
            && (n <= 8 || (isValidFixedExpense(list[8])
            && (n <= 9 || (isValidFixedExpense(list[9])
            && (n <= 10 || isValidFixedExpense(list[n - 1]))
            )))))))))))))))))))
        );
    }

    function areValidFixedExpenses(list) {
      return list is list && areValidFixedExpenseElements(list);
    }

    function areValidVariableExpenseElements(list) {
      let n = list.size();
      return n <= 1500
        && (
          n == 0
          || (
            isValidVariableExpense(list[0])
            && (n <= 1 || (isValidVariableExpense(list[1])
            && (n <= 2 || (isValidVariableExpense(list[2])
            && (n <= 3 || (isValidVariableExpense(list[3])
            && (n <= 4 || (isValidVariableExpense(list[4])
            && (n <= 5 || (isValidVariableExpense(list[5])
            && (n <= 6 || (isValidVariableExpense(list[6])
            && (n <= 7 || (isValidVariableExpense(list[7])
            && (n <= 8 || (isValidVariableExpense(list[8])
            && (n <= 9 || (isValidVariableExpense(list[9])
            && (n <= 10 || isValidVariableExpense(list[n - 1]))
            )))))))))))))))))))
        );
    }

    function areValidVariableExpenses(list) {
      return list is list && areValidVariableExpenseElements(list);
    }

    function isValidJarLogMap(log) {
      let dt = log.get('date', null);
      let title = log.get('exceededJarTitle', null);
      let diff = log.get('diff', null);
      let transferred = log.get('transferredToNextMonth', null);
      let nextKey = log.get('nextMonthKey', null);
      return log.keys().hasOnly(['date', 'exceededJarTitle', 'diff', 'transferredToNextMonth', 'nextMonthKey'])
        && (dt == null || (dt is string && dt.size() <= 50))
        && (title == null || (title is string && title.size() <= 100))
        && (diff == null || diff is number)
        && (transferred == null || transferred is bool)
        && (nextKey == null || (nextKey is string && nextKey.size() <= 20));
    }

    function isValidJarLog(log) {
      return log == null || (log is map && isValidJarLogMap(log));
    }

    function isValidUserDoc(userId, data) {
      let k = data.keys();
      let idVal = data.get('id', userId);
      let lang = data.get('language', 'es');
      let email = data.get('email', null);
      let displayName = data.get('displayName', null);
      let photoURL = data.get('photoURL', null);
      let updatedAt = data.get('updatedAt', '2026-01-01T00:00:00Z');
      let createdAt = data.get('createdAt', '2026-01-01T00:00:00Z');
      return k.hasAll(['uid'])
        && k.hasOnly([
          'uid', 'email', 'displayName', 'photoURL',
          'currency', 'language', 'onboardingSeen',
          'updatedAt', 'createdAt', 'id'
        ])
        && data.uid == userId
        && (idVal == null || (idVal is string && idVal == userId))
        && isValidCurrency(data.get('currency', 'USD'))
        && lang is string && lang.size() > 0 && lang.size() <= 10
        && data.get('onboardingSeen', false) is bool
        && (email == null || (email is string && email.size() <= 320))
        && (displayName == null || (displayName is string && displayName.size() <= 250))
        && (photoURL == null || (photoURL is string && photoURL.size() <= 2048))
        && updatedAt is string && updatedAt.size() >= 10 && updatedAt.size() <= 50
        && createdAt is string && createdAt.size() >= 10 && createdAt.size() <= 50;
    }

    function isValidUserUpdate(userId, inc, cur) {
      return (!('uid' in cur) || cur.uid == userId)
        && (!('createdAt' in cur) || (('createdAt' in inc) && inc.createdAt == cur.createdAt))
        && inc.diff(cur).affectedKeys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL',
          'currency', 'language', 'onboardingSeen',
          'updatedAt', 'id'
        ])
        && isValidUserDoc(userId, inc);
    }

    function isValidCategoriesDoc(userId, data) {
      let k = data.keys();
      let updatedAt = data.get('updatedAt', '2026-01-01T00:00:00Z');
      return k.hasOnly(['userId', 'categories', 'updatedAt'])
        && data.userId == userId
        && areValidCategories(data.categories)
        && updatedAt is string && updatedAt.size() >= 10 && updatedAt.size() <= 50;
    }

    function isValidCategoriesUpdate(userId, inc, cur) {
      return (!('userId' in cur) || cur.userId == userId)
        && inc.diff(cur).affectedKeys().hasOnly(['userId', 'categories', 'updatedAt'])
        && isValidCategoriesDoc(userId, inc);
    }

    function isValidMonthTimestamp(ts) {
      return ts is string && ts.size() >= 10 && ts.size() <= 50;
    }

    function isValidMonthOptionalFields(data) {
      let jarAdj = data.get('jarAdjustments', null);
      let curr = data.get('currency', null);
      let docId = data.get('id', null);
      let syncStatus = data.get('syncStatus', null);
      let isSynced = data.get('isSynced', null);
      return (jarAdj == null || (jarAdj is map && jarAdj.size() <= 100))
        && isValidJarLog(data.get('lastJarAdjustmentLog', null))
        && (!('updatedAt' in data) || isValidMonthTimestamp(data.updatedAt))
        && (!('createdAt' in data) || isValidMonthTimestamp(data.createdAt))
        && (curr == null || isValidCurrency(curr))
        && (docId == null || (docId is string && docId.size() > 0 && docId.size() <= 64))
        && (syncStatus == null || (syncStatus is string && syncStatus.size() <= 32))
        && (isSynced == null || isSynced is bool);
    }

    function isValidMonthDoc(userId, monthKey, data) {
      let k = data.keys();
      return (
          k.size() == 10
          || (
            k.hasOnly([
              'userId', 'monthKey', 'year', 'month', 'income', 'savingsRate',
              'extraDaysPosition', 'categories', 'fixedExpenses', 'variableExpenses',
              'jarAdjustments', 'lastJarAdjustmentLog', 'updatedAt', 'createdAt',
              'currency', 'id', 'syncStatus', 'isSynced'
            ])
            && isValidMonthOptionalFields(data)
          )
        )
        && data.userId == userId
        && data.monthKey == monthKey
        && isCoherentMonthYear(monthKey, data.year, data.month)
        && data.income is number && data.income >= 0
        && data.savingsRate is number && data.savingsRate >= 0 && data.savingsRate <= 100
        && data.extraDaysPosition in ['start', 'end']
        && areValidCategories(data.categories)
        && areValidFixedExpenses(data.fixedExpenses)
        && areValidVariableExpenses(data.variableExpenses);
    }

    function isValidMonthUpdate(userId, monthKey, inc, cur) {
      return (!('userId' in cur) || cur.userId == userId)
        && (!('monthKey' in cur) || cur.monthKey == monthKey)
        && (!('createdAt' in cur) || (('createdAt' in inc) && inc.createdAt == cur.createdAt))
        && inc.diff(cur).affectedKeys().hasOnly([
          'userId', 'monthKey', 'year', 'month', 'income', 'savingsRate',
          'extraDaysPosition', 'categories', 'fixedExpenses', 'variableExpenses',
          'jarAdjustments', 'lastJarAdjustmentLog', 'updatedAt', 'currency', 'id',
          'syncStatus', 'isSynced'
        ])
        && isValidMonthDoc(userId, monthKey, inc);
    }

    // 5. Documento de perfil de usuario (/users/{userId})
    match /users/{userId} {
      allow get: if isAuthorizedOwner(userId);
      allow list: if false;
      allow delete: if false;

      allow create: if isAuthorizedOwner(userId)
        && isValidUserDoc(userId, request.resource.data);

      allow update: if isAuthorizedOwner(userId)
        && isValidUserUpdate(userId, request.resource.data, resource.data);

      // 6. Categorías globales (/users/{userId}/categories/global)
      match /categories/{docId} {
        allow get: if docId == 'global' && isAuthorizedOwner(userId);
        allow list: if isAuthorizedOwner(userId);
        allow delete: if false;

        allow create: if docId == 'global'
          && isAuthorizedOwner(userId)
          && isValidCategoriesDoc(userId, request.resource.data);

        allow update: if docId == 'global'
          && isAuthorizedOwner(userId)
          && isValidCategoriesUpdate(userId, request.resource.data, resource.data);
      }

      // 7. Presupuestos mensuales (/users/{userId}/months/{monthKey})
      match /months/{monthKey} {
        allow get: if isValidMonthKey(monthKey) && isAuthorizedOwner(userId);
        allow list: if isAuthorizedOwner(userId);
        allow delete: if false;

        allow create: if isValidMonthKey(monthKey)
          && isAuthorizedOwner(userId)
          && isValidMonthDoc(userId, monthKey, request.resource.data);

        allow update: if isValidMonthKey(monthKey)
          && isAuthorizedOwner(userId)
          && isValidMonthUpdate(userId, monthKey, request.resource.data, resource.data);
      }
    }
  }
}
